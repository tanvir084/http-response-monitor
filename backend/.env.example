# Application Configuration
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# MongoDB Configuration
# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/http-monitor

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/http-monitor?retryWrites=true&w=majority

For Docker:
MONGODB_URI=mongodb://mongodb:27017/http-monitor

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:3000

# HTTP Monitor Configuration
# The external endpoint to monitor
MONITOR_TARGET_URL=https://httpbin.org/anything

# Logging Configuration (optional)
LOG_LEVEL=debug

# AWS CloudWatch Logs Configuration (Optional - for production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# CLOUDWATCH_LOG_GROUP=/aws/nestjs/http-monitor
# CLOUDWATCH_LOG_STREAM=application-logs